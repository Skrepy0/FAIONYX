{
  "name": "faionyx",
  "productName": "FAIONYX",
  "version": "1.0.1",
  "description": "FAIONYX - FLY の Minecraft 启动器",
  "author": "Skrepy-i <155234406+Skrepy0@users.noreply.github.com>",
  "homepage": "https://github.com/Skrepy0/FAIONYX",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "tsx --test tests/all.test.ts",
    "start": "electron-vite preview",
    "visual-ids": "npx tsx scripts/visual-ids.ts",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never && node scripts/pack-windows-zip.cjs",
    "dist:mac": "node scripts/pack-mac.mjs",
    "dist:linux": "node scripts/pack-linux.cjs",
    "prepare:harmonyos": "node scripts/prepare-harmonyos.cjs",
    "dist:harmonyos": "node scripts/build-harmonyos.cjs",
    "verify:harmonyos": "node scripts/verify-harmonyos.cjs",
    "dist:all": "node scripts/dist-platform.cjs",
    "license:check": "node scripts/check-licenses.cjs",
    "format": "prettier --write .",
    "lang:update": "node scripts/gen-locales.cjs",
    "lang:check": "node scripts/check-locales.cjs",
    "pack": "node scripts/pack-source.cjs"
  },
  "build": {
    "electronDist": "D:\\Front-projects\\FAIONYX\\node_modules\\electron\\electron-v44.3.0-win32-x64",
    "appId": "com.faionyx.launcher",
    "productName": "FAIONYX",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "package.json",
      "!out/**/*.map",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**",
      "docs/CORRESPONDING_SOURCE.md"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asarUnpack": [
      "out/main/WindowMaterial.exe",
      "out/main/GameWindowFocus.exe",
      "out/main/MacGameWindow",
      "out/main/LinuxGameWindow",
      "out/main/faionyx-bridge.jar",
      "out/main/faionyx-offline-skin.jar"
    ],
    "beforePack": "scripts/portable-build-hook.cjs",
    "afterPack": "scripts/verify-windows-runtime.cjs",
    "win": {
      "files": [
        "out/main/**",
        "out/preload/**",
        "out/renderer/**",
        "package.json",
        "!out/**/*.map",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "licenses/**",
        "docs/CORRESPONDING_SOURCE.md",
        "!node_modules/koffi/doc{,/**}",
        "!node_modules/koffi/lib{,/**}",
        "!node_modules/koffi/vendor{,/**}",
        "!node_modules/koffi/cnoke.cjs",
        "!node_modules/undici/docs{,/**}"
      ],
      "target": [
        "portable",
        "zip"
      ],
      "artifactName": "FAIONYX-${version}-windows-${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "portable": {
      "unpackDirName": false,
      "artifactName": "FAIONYX-${version}.exe"
    },
    "appImage": {
      "executableArgs": []
    },
    "mac": {
      "minimumSystemVersion": "13.0.0",
      "target": [
        "zip"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon-512.png",
      "identity": null,
      "artifactName": "FAIONYX-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "maintainer": "Skrepy-i <155234406+Skrepy0@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Game",
      "executableName": "faionyx",
      "icon": "build/icon-512.png",
      "artifactName": "FAIONYX-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "FAIONYX",
          "Comment": "Minecraft launcher",
          "Categories": "Game;",
          "StartupWMClass": "FAIONYX"
        }
      },
      "synopsis": "Minecraft launcher"
    }
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "adm-zip": "^0.6.0",
    "koffi": "^3.2.1",
    "prettier": "^3.9.9",
    "undici": "^6.28.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.9.0",
    "@types/three": "0.185.0",
    "@types/ws": "8.18.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "asar": "^3.2.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "minecraft-data": "3.117.0",
    "sharp": "^0.35.4",
    "skinview-utils": "0.7.1",
    "three": "^0.185.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "license": "SEE LICENSE IN LICENSE"
}
